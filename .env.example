# Devin Enterprise API key (service user key or PAT, starts with cog_).
# Leave unset to run in demo mode against the bundled synthetic dataset.
DEVIN_API_KEY=

# Required when your key is scoped to a single organization.
DEVIN_ORG_ID=

DEVIN_API_BASE_URL=https://api.devin.ai

# Optional: dollar price per ACU. Unset -> dollar KPIs are hidden.
ACU_UNIT_PRICE=

# Optional git provider enrichment (PR cycle time, review load, diff size).
GITHUB_TOKEN=
GITLAB_TOKEN=
AZURE_DEVOPS_PAT=

# Optional issue tracker enrichment (story points -> cost per story point).
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_STORY_POINTS_FIELD=customfield_10016
LINEAR_API_KEY=

ISSUE_KEY_REGEX=[A-Z][A-Z0-9]+-\d+

# Optional: licensed seat count for active-vs-licensed adoption KPI.
SEAT_COUNT=

DATABASE_PATH=data/devin_kpi.sqlite
DEMO_DATABASE_PATH=data/demo.sqlite
CONSUMPTION_DAY_TZ=America/Los_Angeles
